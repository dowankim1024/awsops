# AWSops Dashboard Environment Variables
# Copy to .env.local and fill in values

# Steampipe (optional — defaults to 'steampipe')
STEAMPIPE_PASSWORD=steampipe

# AWS Region (optional — defaults to ap-northeast-2)
AWS_REGION=ap-northeast-2

# Node.js
NODE_ENV=production
PORT=3000

# Single-user mode: skip adminEmails gating. Safe only because the EC2 has no inbound
# rule and is reached via SSM port forwarding (see docs/decisions/011-ssm-only-deployment.md).
AWSOPS_SINGLE_USER=true
